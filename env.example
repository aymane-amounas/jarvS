# Copy to .env and fill in. Never commit this file.
JARVIS_HOME=.
OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_PLAN_MODEL=dolphin-mistral:7b
JARVIS_FAST_MODEL=huihui_ai/qwen3-abliterated:4b
JARVIS_LLM_KEEP_ALIVE=5m
JARVIS_LLM_CONNECT_TIMEOUT=5
JARVIS_LLM_READ_TIMEOUT=300
# Minutes with no queued WhatsApp task before the worker self-selects a
# mission from missions.yaml.
JARVIS_IDLE_MINUTES=5
# The shell tool runs arbitrary commands with this account's rights and is NOT
# sandboxed. Off by default; set to 1 only if you accept that risk.
JARVIS_ALLOW_SHELL=0
JARVIS_SHELL_TIMEOUT=120
JARVIS_SSH_TIMEOUT=60
# Direct WhatsApp JIDs allowed to send tasks; empty blocks all inbound messages.
JARVIS_ALLOWED=
# Set to 1 temporarily to log JIDs for blocked direct senders during setup.
JARVIS_LOG_UNKNOWN_JIDS=0
# Owner JID receives mission reports/notifications and may manage pending tools.
JARVIS_OWNER_JID=
JARVIS_VOICE_OUT=0
# piper (default, already wired) or kokoro
JARVIS_TTS_ENGINE=piper
PIPER_MODEL=voices/en_US-amy-medium.onnx
KOKORO_MODEL=voices/kokoro-v1.0.onnx
KOKORO_VOICES=voices/voices-v1.0.bin
KOKORO_VOICE=af_heart
WHISPER_MODEL=base
# GitHub CLI can be authenticated interactively with `gh auth login` as the
# service user. Gmail setup exists, but Gmail actions are not wired into jarvS.
GITHUB_TOKEN=
GMAIL_CREDENTIALS_PATH=gmail_credentials.json
GMAIL_TOKEN_PATH=gmail_token.json
# Optional dashboard binds to localhost; use an SSH tunnel to view remotely.
JARVIS_DASHBOARD_PORT=8899
